{
	"name": "mcp-pool",
	"version": "0.2.0",
	"description": "MCP Key Pool Proxy — pool multiple API keys across upstream MCP servers",
	"type": "module",
	"bin": {
		"mcp-pool": "./bin/mcp-pool.js"
	},
	"files": [
		"bin/",
		"dist/",
		"src/*.ts",
		"!src/*.test.ts",
		"README.md"
	],
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.6.0",
		"yaml": "^2.7.1",
		"zod": "^3.24.4"
	},
	"devDependencies": {
		"@biomejs/biome": "^2",
		"@types/bun": "latest",
		"typescript": "^5.7.0"
	},
	"scripts": {
		"build": "rm -rf dist && tsc",
		"typecheck": "tsc --project tsconfig.typecheck.json",
		"prepare": "bun run build",
		"postinstall": "command -v bun >/dev/null 2>&1 || exit 0; [ -f src/index.ts ] || exit 0; bun build --compile src/index.ts --outfile ./mcp-pool-bin --minify",
		"start": "node dist/index.js",
		"dev": "bun --watch src/index.ts",
		"test": "bun test src/ test/startup-cleanup.test.ts test/daemon-sharing.test.ts",
		"smoke": "bun run test/smoke-test.ts",
		"check:package": "! bun pm pack --dry-run 2>&1 | grep -E '(dist|src)/.*\\.test\\.(ts|js|d\\.ts|js\\.map|d\\.ts\\.map)'",
		"lint": "biome check",
		"format": "biome check --write"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/yuzu-octopus/mcp-pool.git"
	},
	"bugs": {
		"url": "https://github.com/yuzu-octopus/mcp-pool/issues"
	},
	"homepage": "https://github.com/yuzu-octopus/mcp-pool#readme",
	"keywords": [
		"mcp",
		"model-context-protocol",
		"proxy",
		"rate-limit",
		"api-key"
	],
	"license": "MIT"
}
